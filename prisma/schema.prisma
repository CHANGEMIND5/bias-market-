generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id // Google account subject (sub)
  email          String     @unique
  name           String?
  image          String?
  balance        Float      @default(10000)
  xp             Int        @default(0)
  lastRewardDate String?
  refCode        String?    @unique // 내 초대 코드
  referredBy     String? // 나를 초대한 유저의 id
  refRewarded    Boolean    @default(false) // 첫 거래 초대 보상 지급 여부
  refCount       Int        @default(0) // 성공한 초대 수
  createdAt      DateTime   @default(now())
  holdings       Holding[]
  trades         Trade[]
  favorites      Favorite[]
  influence      Int        @default(0) // 미션 등으로 획득한 영향력 보너스
  posts          Post[]
  postLikes      PostLike[]
  comments       Comment[]
  reports        Report[]
  rewardState    UserRewardState?
  missions       MissionProgress[]
  rewardLedger   RewardLedger[]
}

model UserRewardState {
  userId                  String   @id
  currentStreak           Int      @default(0)
  lastCheckInDate         String? // KST YYYY-MM-DD
  dailyAllClaimedDate     String? // 오늘의 미션 전체 완료 보상 수령일
  dailyBonusClaimedDate   String? // 일일 완료 보너스 수령일
  weeklyClaimedKey        String? // 마지막으로 주간 보상을 받은 weekKey
  onboardingRewardClaimed Boolean  @default(false)
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MissionProgress {
  id          String   @id @default(cuid())
  userId      String
  periodKey   String // "D:2026-07-16" | "W:2026-07-14" | "ONB"
  missionType String
  progress    Int      @default(0)
  target      Int
  completed   Boolean  @default(false)
  meta        String? // 중복 방지용 키 목록 (쉼표 구분)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey, missionType])
  @@index([userId, periodKey])
}

model RewardLedger {
  id        String   @id @default(cuid())
  userId    String
  sourceKey String   @unique // 멱등성 키 — 중복 지급 원천 차단
  fan       Float    @default(0)
  xp        Int      @default(0)
  influence Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  postId     String?
  commentId  String?
  reason     String?
  createdAt  DateTime @default(now())
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
}

model Post {
  id        String     @id @default(cuid())
  userId    String
  body      String
  isNotice  Boolean    @default(false)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  Comment[]
  reports   Report[]

  @@index([createdAt])
}

model PostLike {
  userId String
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@index([postId, createdAt])
}

model Market {
  groupId      String @id
  fanReserve   Float
  shareReserve Float
  systemShares Float  @default(0) // marketActivityBot이 보유한 Fan Shares (총량 보존용)
  baseline1h   Float
  baseline24h  Float
  baseline7d   Float
  volume24h    Float
  holders      Int
}

model Holding {
  userId  String
  groupId String
  shares  Float
  cost    Float
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String? // null = 시스템 거래 (marketActivityBot)
  groupId   String
  side      String // "buy" | "sell"
  price     Float
  shares    Float
  fan       Float
  fee       Float
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([groupId, createdAt])
  @@index([isSystem, createdAt])
}

model PricePoint {
  id        String   @id @default(cuid())
  groupId   String
  price     Float
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

model Favorite {
  userId  String
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}
