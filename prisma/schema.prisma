generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id // Google account subject (sub)
  email          String     @unique
  name           String?
  image          String?
  balance        Float      @default(10000)
  xp             Int        @default(0)
  lastRewardDate String?
  createdAt      DateTime   @default(now())
  holdings       Holding[]
  trades         Trade[]
  favorites      Favorite[]
  posts          Post[]
  postLikes      PostLike[]
  comments       Comment[]
}

model Post {
  id        String     @id @default(cuid())
  userId    String
  body      String
  isNotice  Boolean    @default(false)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  Comment[]

  @@index([createdAt])
}

model PostLike {
  userId String
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Market {
  groupId      String @id
  fanReserve   Float
  shareReserve Float
  systemShares Float  @default(0) // marketActivityBot이 보유한 Fan Shares (총량 보존용)
  baseline1h   Float
  baseline24h  Float
  baseline7d   Float
  volume24h    Float
  holders      Int
}

model Holding {
  userId  String
  groupId String
  shares  Float
  cost    Float
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String? // null = 시스템 거래 (marketActivityBot)
  groupId   String
  side      String // "buy" | "sell"
  price     Float
  shares    Float
  fan       Float
  fee       Float
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([groupId, createdAt])
  @@index([isSystem, createdAt])
}

model PricePoint {
  id        String   @id @default(cuid())
  groupId   String
  price     Float
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

model Favorite {
  userId  String
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}
