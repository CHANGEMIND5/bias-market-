generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id // Google account subject (sub)
  email          String     @unique
  name           String?
  image          String?
  balance        Float      @default(10000)
  xp             Int        @default(0)
  lastRewardDate String?
  refCode        String?    @unique // 내 초대 코드
  referredBy     String? // 나를 초대한 유저의 id
  refRewarded    Boolean    @default(false) // 첫 거래 초대 보상 지급 여부
  refCount       Int        @default(0) // 성공한 초대 수
  selectedTitle  String? // 글에 표시할 칭호 코드 (예: "G:2026-07:bts", "C:2026-07:1")
  createdAt      DateTime   @default(now())
  holdings       Holding[]
  trades         Trade[]
  favorites      Favorite[]
  influence      Int        @default(0) // 미션 등으로 획득한 영향력 보너스
  posts          Post[]
  postLikes      PostLike[]
  comments       Comment[]
  reports        Report[]
  rewardState    UserRewardState?
  missions       MissionProgress[]
  rewardLedger   RewardLedger[]
  starterPortfolio StarterPortfolio?
  starterOnboarding StarterOnboardingProgress?
}

model UserRewardState {
  userId                  String   @id
  currentStreak           Int      @default(0)
  lastCheckInDate         String? // KST YYYY-MM-DD
  dailyAllClaimedDate     String? // 오늘의 미션 전체 완료 보상 수령일
  dailyBonusClaimedDate   String? // 일일 완료 보너스 수령일
  weeklyClaimedKey        String? // 마지막으로 주간 보상을 받은 weekKey
  onboardingRewardClaimed Boolean  @default(false)
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MissionProgress {
  id          String   @id @default(cuid())
  userId      String
  periodKey   String // "D:2026-07-16" | "W:2026-07-14" | "ONB"
  missionType String
  progress    Int      @default(0)
  target      Int
  completed   Boolean  @default(false)
  meta        String? // 중복 방지용 키 목록 (쉼표 구분)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey, missionType])
  @@index([userId, periodKey])
}

model RewardLedger {
  id             String   @id @default(cuid())
  userId         String
  sourceKey      String   @unique // 멱등성 키 — 중복 지급 원천 차단
  fan            Float    @default(0)
  xp             Int      @default(0)
  influence      Int      @default(0)
  rewardType     String   @default("") // 예: SIGNUP, STARTER_PORTFOLIO_REWARD, DAILY_CHECKIN...
  marketId       String? // Fan Shares 지급 시 대상 마켓
  shareAmount    Decimal? @db.Decimal(30, 8) // 지급된 Fan Shares 수량
  referencePrice Decimal? @db.Decimal(30, 8) // 지급 시 기준 가격
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── 스타터 팬덤 포트폴리오 ───
model StarterPortfolio {
  id                    String    @id @default(cuid())
  userId                String    @unique
  status                String    @default("NOT_STARTED") // NOT_STARTED | STAGE1_CLAIMED | COMPLETED
  selectionConfirmedAt  DateTime?
  stage1ClaimedAt       DateTime?
  onboardingCompletedAt DateTime?
  stage2ClaimedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations           StarterPortfolioAllocation[]
}

model StarterPortfolioAllocation {
  id                  String  @id @default(cuid())
  portfolioId         String
  marketId            String // groupId
  role                String // MAIN | SUB
  referencePrice      Decimal @db.Decimal(30, 8) // 선택 확정 시점 서버 기준가 (양 스테이지 공통)
  stage1FanValue      Decimal @db.Decimal(30, 8)
  stage1ShareQuantity Decimal @db.Decimal(30, 8)
  stage2FanValue      Decimal @db.Decimal(30, 8)
  stage2ShareQuantity Decimal @db.Decimal(30, 8)
  stage1Claimed       Boolean @default(false)
  stage2Claimed       Boolean @default(false)
  portfolio           StarterPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, marketId])
}

model StarterOnboardingProgress {
  userId              String    @id
  visitedMarkets      String    @default("") // 중복 방지: 방문한 그룹 id CSV
  portfolioViewed     Boolean   @default(false)
  firstTradeCompleted Boolean   @default(false)
  battleViewed        Boolean   @default(false)
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  postId       String?
  commentId    String?
  reason       String? // harassment | hate | spam | misinfo | privacy | manipulation | inappropriate | other
  details      String?
  status       String   @default("OPEN") // OPEN | REVIEWED | DISMISSED
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime @default(now())
  reporter     User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
}

model Post {
  id        String     @id @default(cuid())
  userId    String
  body      String
  title     String?
  isNotice  Boolean    @default(false) // 전체 커뮤니티 공지 (기존 호환)
  // ─── 팬덤 라운지 ───
  scope            String   @default("GLOBAL") // GLOBAL | MARKET
  marketId         String? // scope=MARKET일 때 대상 groupId
  postType         String   @default("GENERAL") // GENERAL | MARKET_TALK | BATTLE | POLL
  isPinned         Boolean  @default(false) // 라운지 상단 고정
  isLocked         Boolean  @default(false) // 댓글 잠금
  moderationStatus String   @default("VISIBLE") // VISIBLE | UNDER_REVIEW | HIDDEN
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  Comment[]
  reports   Report[]
  poll      CommunityPoll?

  @@index([createdAt])
  @@index([scope, marketId, createdAt])
  @@index([postType])
}

// ─── 팬덤 라운지 투표 ───
model CommunityPoll {
  id       String                @id @default(cuid())
  postId   String                @unique
  closesAt DateTime
  closedAt DateTime?
  post     Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  options  CommunityPollOption[]
  votes    CommunityPollVote[]
}

model CommunityPollOption {
  id        String              @id @default(cuid())
  pollId    String
  text      String
  sortOrder Int                 @default(0)
  poll      CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     CommunityPollVote[]

  @@index([pollId])
}

model CommunityPollVote {
  id        String              @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime            @default(now())
  poll      CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    CommunityPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId]) // 유저당 1표 (변경 시 optionId 갱신)
  @@index([pollId])
}

model PostLike {
  userId String
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@index([postId, createdAt])
}

model Market {
  groupId      String  @id
  // ─── 이코노미 v2 정밀 원장 (DB Decimal이 최종 진실, JS에서는 읽을 때 Number 변환) ───
  fanReserve   Decimal @db.Decimal(30, 8) // poolFan — AMM 풀의 Fan$ (x)
  shareReserve Decimal @db.Decimal(30, 8) // poolShares — AMM 풀의 Fan Shares (y)
  totalFanShares           Decimal @default(1000000) @db.Decimal(30, 8)
  systemReserveShares      Decimal @default(0) @db.Decimal(30, 8) // 풀 밖 시스템 준비금
  initialReserveShares     Decimal @default(0) @db.Decimal(30, 8)
  systemTreasuryFan        Decimal @default(0) @db.Decimal(30, 8) // 시스템 봇 Fan$ 금고
  starterSharesDistributed Decimal @default(0) @db.Decimal(30, 8)
  missionSharesDistributed Decimal @default(0) @db.Decimal(30, 8)
  systemBotNetShares       Decimal @default(0) @db.Decimal(30, 8) // 봇 순매도(+)/순매수(-) 누적
  initialPrice             Decimal @default(0) @db.Decimal(30, 8)
  economyVersion           Int     @default(1)
  // ─── 팬덤 라운지 상태 (AUTO=티어 기반 자동 판정) ───
  loungeStatus           String    @default("AUTO") // AUTO | ACTIVE | LOCKED | DISABLED
  loungeActivatedAt      DateTime?
  loungeActivationReason String? // DEFAULT_TIER | COMMUNITY_THRESHOLD | ADMIN
  baseline1h   Float
  baseline24h  Float
  baseline7d   Float
  volume24h    Float
  holders      Int
}

model Holding {
  userId  String
  groupId String
  shares  Decimal @db.Decimal(30, 8)
  cost    Decimal @db.Decimal(30, 8) // 취득 기준 Fan$ (스타터 보상은 기준가로 산정)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String? // null = 시스템 거래 (marketActivityBot)
  groupId   String
  side      String // "buy" | "sell"
  price     Float
  shares    Float
  fan       Float
  fee       Float
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([groupId, createdAt])
  @@index([isSystem, createdAt])
}

// 주간 팬덤 배틀 스냅샷 — 매주 롤오버 시 지난주 랭킹을 1회 저장
model WeeklyFandom {
  weekKey   String   @id // KST 주 키 (그 주 월요일 날짜)
  data      String // JSON: [{ groupId, rank, score, ch24 }]
  createdAt DateTime @default(now())
}

// 월간 시즌 — 롤오버 시 청산+마켓 리셋+명예의 전당 기록
model Season {
  seasonKey  String    @id // KST "YYYY-MM"
  status     String    @default("closed") // closed = 롤오버 완료
  hallOfFame String? // JSON: [{ userId, name, wealth, rank }]
  closedAt   DateTime  @default(now())
}

// 시즌 영구 배지 — 각 그룹 최대 보유자 + 시즌 챔피언
model SeasonBadge {
  id        String   @id @default(cuid())
  userId    String
  seasonKey String
  groupId   String // 실제 그룹 id, 또는 "__champion_1__".."__champion_3__"
  kind      String   @default("GROUP_TOP") // GROUP_TOP | CHAMPION
  rank      Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([seasonKey, groupId]) // 그룹당 시즌당 1명
  @@index([userId])
}

model PricePoint {
  id        String   @id @default(cuid())
  groupId   String
  price     Float
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

model Favorite {
  userId  String
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}
